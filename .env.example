# Transaction pooler (port 6543). Ordinary queries and mutations.
# Serverless-safe, high concurrency. Client must set prepare: false.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres

# Session pooler (port 5432). Required for LISTEN -- the transaction
# pooler does not support it (D3b). Used only by the SSE route handler.
DATABASE_URL_SESSION=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Direct connection. Used only for running migrations (needs
# session-level state).
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
