# Origin of apps/web's mounted rpc route (D13: this process is
# separate from the Next.js app and talks to it over plain HTTP).
TERMINAL_SERVER_URL=http://localhost:3000

# This device's own long-lived token (D16), minted once via
# issueDeviceToken -- packages/db/src/seed.ts prints one for the demo
# facility's TERMINAL device on every `pnpm db:seed`.
TERMINAL_DEVICE_TOKEN=<device-token-from-seed-output>
